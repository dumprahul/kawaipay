# kawaipay backend (Railway)
NEXT_PUBLIC_GATEWAY_URL=https://gateway-production-d648.up.railway.app
NEXT_PUBLIC_ORACLE_API_URL=https://oracle-api-production-7bca.up.railway.app

# Sui network
NEXT_PUBLIC_SUI_NETWORK=testnet

# Enoki (zkLogin prover + salt, hosted by Mysten Labs) — https://portal.enoki.mystenlabs.com
NEXT_PUBLIC_ENOKI_API_KEY=your_enoki_public_api_key_here

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=715509323266-2kc2tnre68fi5ivcn75htngfqsqq59a1.apps.googleusercontent.com

# Apple OAuth
NEXT_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id_here

# Twitch OAuth
NEXT_PUBLIC_TWITCH_CLIENT_ID=your_twitch_client_id_here

# No redirect URI env var needed — it's derived at runtime from window.location.origin
# (see lib/zklogin.ts). Just make sure every origin you actually run this on
# (http://localhost:3000, your deployed domain, ...) has "<that origin>/login/callback"
# registered as an authorized redirect URI in the Google/Twitch OAuth console.

# Funded testnet seller keypair used only by scripts/seedProducts.ts — never a real key here
SEED_SELLER_SECRET_KEY=suiprivkey1your_testnet_seller_secret_key_here

# World ID (Proof of Humanity, gates creator payouts beyond the free ones — see
# services/gateway/src/worldId.ts). From https://developer.worldcoin.org
NEXT_PUBLIC_WORLD_APP_ID=app_staging_your_world_app_id_here
NEXT_PUBLIC_WORLD_ENVIRONMENT=staging