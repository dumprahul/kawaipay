# kawaipay backend (Railway)
NEXT_PUBLIC_GATEWAY_URL=https://gateway-production-d648.up.railway.app
NEXT_PUBLIC_ORACLE_API_URL=https://oracle-api-production-7bca.up.railway.app

# Sui network
NEXT_PUBLIC_SUI_NETWORK=testnet

# Enoki (zkLogin prover + salt, hosted by Mysten Labs) — https://portal.enoki.mystenlabs.com
NEXT_PUBLIC_ENOKI_API_KEY=your_enoki_public_api_key_here

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=715509323266-2kc2tnre68fi5ivcn75htngfqsqq59a1.apps.googleusercontent.com

# Apple OAuth
NEXT_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id_here

# Twitch OAuth
NEXT_PUBLIC_TWITCH_CLIENT_ID=your_twitch_client_id_here

# Redirect URI — must match what you register in each OAuth provider's console
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/login/callback
