# Copy this to .env at the repo root and fill in real values for local dev.
# Every service reads from this same file (packages/shared/src/loadEnv.ts walks up from
# wherever it's run to find it) — you don't need one .env per service.
#
# On a real deploy (Railway, etc.) none of this applies: set these as real environment
# variables in that platform's own dashboard instead, per service, using the same names.

# ---- Shared: Postgres ----
# Supabase: Connect button -> Session pooler (or Direct connection) tab, port 5432.
# Avoid the Transaction pooler (port 6543) for the batcher specifically — its leader
# election holds a session-level advisory lock that transaction-mode pooling breaks.
DATABASE_URL=postgres://postgres:password@localhost:5432/kawaipay

# ---- gateway ----
REDIS_URL=redis://127.0.0.1:6379
IP_HASH_SALT=change-me-to-a-long-random-string
# PORT=8080
# TICK_MS=5000
# SESSION_TTL_MS=900000
# MIN_LINK_BUDGET=10000

# ---- batcher ----
PACKAGE_ID=0x783ffc3f10c07ed01ba7799b92f2bbd663c1b2bbe3ac574dc03598e2f6a93e03
REGISTRY_ID=0xf3d190c8ad619ded4d8bc47b8299e4577c17a9ce5b761475b56cb956d8d52f9b
USDC_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
SUI_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
# SUI_NETWORK=testnet
ORACLE_SIGNER_KEY=replace-with-the-real-hex-seed
RELAYER_KEY=replace-with-the-real-hex-seed
LOG_SECRET=change-me-must-match-log-writer-and-oracle-api
# RELAYER_MIN_SUI=100000000
# BATCH_INTERVAL_MS=
# ATT_TTL_MS=
# MAX_ITEMS_PER_BATCH=
# MIN_SETTLE_UNITS=
# MIRROR_MAX_LAG_MS=
# METRICS_PORT=9101

# ---- indexer ----
# (reuses PACKAGE_ID, SUI_GRAPHQL_URL, SUI_NETWORK above)
# METRICS_PORT=9103

# ---- log-writer ----
# (reuses DATABASE_URL, LOG_SECRET above — must be the SAME value as batcher's)
LOG_STORE_DIR=./data/logs
# LOG_WRITER_POLL_INTERVAL_MS=30000
# METRICS_PORT=9104

# ---- sentinel ----
# (only needs DATABASE_URL above)
# SENTINEL_LOOKBACK_MS=7200000
# SENTINEL_POLL_INTERVAL_MS=60000
# METRICS_PORT=9102

# ---- oracle-api ----
# (reuses USDC_TYPE above)
PAY_TO=replace-with-the-address-that-should-receive-payments
# FACILITATOR_URL=https://sui-facilitator.onrender.com
# X402_NETWORK=sui:testnet
# PRICE_BASE_UNITS=1000
# MAX_TIMEOUT_SECONDS=60
# PORT=8081
